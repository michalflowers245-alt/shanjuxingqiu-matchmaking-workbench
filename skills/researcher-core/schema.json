{
  "metadata": {"version": "1.3.0", "role": "researcher"},
  "input": {
    "required": ["task", "brand_profile", "sources"],
    "description": "写作任务、常用信息、内部资料与联网检索上下文"
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "brief": {"type": "string"},
      "customer_questions": {"type": "array", "items": {"type": "string"}},
      "objections": {"type": "array", "items": {"type": "string"}},
      "competitor_patterns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"pattern": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "source_urls": {"type": "array", "items": {"type": "string"}}}, "required": ["pattern", "source_ids", "source_urls"]}},
      "angles": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"title": {"type": "string"}, "why": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "source_urls": {"type": "array", "items": {"type": "string"}}}, "required": ["title", "why", "source_ids", "source_urls"]}},
      "recommended_angle": {"type": "object", "additionalProperties": false, "properties": {"title": {"type": "string"}, "reason": {"type": "string"}}, "required": ["title", "reason"]},
      "evidence_gaps": {"type": "array", "items": {"type": "string"}},
      "conversion_hypothesis": {"type": "string"},
      "life_case_observation": {"type": "object", "additionalProperties": false, "properties": {
        "user_facts": {"type": "array", "items": {"type": "string"}},
        "visible_facts": {"type": "array", "items": {"type": "string"}},
        "uncertain_items": {"type": "array", "items": {"type": "string"}},
        "privacy_notes": {"type": "array", "items": {"type": "string"}}
      }, "required": ["user_facts", "visible_facts", "uncertain_items", "privacy_notes"]}
    },
    "required": ["brief", "customer_questions", "objections", "competitor_patterns", "angles", "recommended_angle", "evidence_gaps", "conversion_hypothesis", "life_case_observation"]
  }
}
